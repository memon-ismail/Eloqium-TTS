---
import BaseLayout from '../layouts/BaseLayout.astro';
import { currentRelease, releases } from '../data/site';
---

<BaseLayout
  title="Releases | Eloqium TTS"
  description="Eloqium TTS release history, including features, fixes, compatibility notes, and APK downloads for published versions."
  currentPath="/releases/"
>
  <div class="shell"><header class="page-intro"><p class="eyebrow">Releases</p><h1>Release history</h1><p class="page-lead">This page records the published Eloqium releases and the main changes introduced in each version. The current release appears first, followed by earlier versions.</p></header></div>

  <section class="page-section" aria-labelledby="release-list-heading">
    <div class="shell release-history">
      <div class="section-heading"><p class="eyebrow">Published versions</p><h2 id="release-list-heading">What changed over time.</h2><p class="section-summary">Use the version entries below to see when features were introduced, what was changed, and which APK corresponds to each release.</p></div>
      <div class="release-list">
        {releases.map((release) => (
          <article class:list={["release-entry", release.version === currentRelease.version && "release-entry-current"]}>
            <div class="release-entry-header">
              <div><p class="release-date">{release.date}</p><h3>{release.version} <span>{release.title}</span></h3></div>
              {release.version === currentRelease.version && <span class="release-status">Current release</span>}
            </div>
            <p class="release-summary">{release.summary}</p>
            <h4>Changes</h4>
            <ul class="change-list">{release.changes.map((change) => <li>{change}</li>)}</ul>
            <div class="release-entry-footer">
              {release.downloadUrl ? (
                <>
                  <a class="arrow-link" href={release.downloadUrl}>Download {release.version} <span aria-hidden="true">↓</span></a>
                  <a class="text-link" href={release.githubUrl} target="_blank" rel="noreferrer">View {release.version} on GitHub <span aria-hidden="true">↗</span></a>
                </>
              ) : (
                <a class="arrow-link" href={release.githubUrl} target="_blank" rel="noreferrer">View release on GitHub <span aria-hidden="true">↗</span></a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
