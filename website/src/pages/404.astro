---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkArrow from '../components/LinkArrow.astro';
---

<BaseLayout title="Page not found | Eloqium TTS" description="The requested Eloqium TTS page could not be found." currentPath="/404/" noindex>
  <section class="error-page"><div class="shell narrow-copy"><p class="eyebrow">404</p><h1>Page not found</h1><p class="page-lead">The address you opened does not correspond to a page on the Eloqium website. Return to the homepage or use the navigation menu to find the information you were looking for.</p><LinkArrow href="/" label="Return to the Eloqium TTS homepage" /></div></section>
</BaseLayout>
