---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkArrow from '../components/LinkArrow.astro';
import { currentRelease, site } from '../data/site';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android',
  description: 'An open-source alternative to the Eloquence TTS engine for Android.',
  downloadUrl: currentRelease.downloadUrl || `${site.github}/releases`,
  softwareVersion: site.currentVersion
};
---

<BaseLayout
  title="An open-source alternative to Eloquence TTS for Android | Eloqium TTS"
  description="Eloqium TTS is an Android text-to-speech engine featuring regional voices, advanced speech controls, punctuation and text processing, emoji and emoticon support, and custom pronunciation dictionaries."
  currentPath="/"
  schema={homeSchema}
>
  <section class="home-hero">
    <div class="shell home-hero-main">
      <p class="eyebrow">Android text-to-speech</p>
      <h1>An open-source alternative to Eloquence TTS for Android.</h1>
      <p class="hero-lead">Eloqium TTS is designed for people who want an Android speech engine they can configure in detail. It works through Android’s standard text-to-speech system and provides a collection of regional voices together with controls for speech rate, pitch, volume, voice characteristics, punctuation, numbers, abbreviations, emoji, emoticons, and personal pronunciation.</p>
      <div class="button-row">
        <a class="button button-primary" href="/download/">Download the latest version</a>
        <a class="button button-secondary" href="/guide/">Read the user guide</a>
      </div>
    </div>
  </section>

  <section class="page-section home-section" aria-labelledby="home-overview-heading">
    <div class="shell home-section-intro">
      <p class="eyebrow">What Eloqium provides</p>
      <h2 id="home-overview-heading">A single Android TTS engine with controls for both speech and text.</h2>
      <p class="section-summary">For basic use, you can select a language and voice profile and leave the remaining settings at their defaults. Additional controls are available when you want to change how punctuation is spoken, how numbers are grouped, how abbreviations are expanded, or how a particular name is pronounced. These options are provided within the same application rather than requiring a separate tool for each adjustment.</p>
    </div>
    <div class="shell home-capability-grid">
      <a class="home-capability" href="/voices/">
        <span class="capability-number">01</span>
        <h3>Voices and regional variants</h3>
        <p>Eloqium currently provides eight supported regional variants. Each one has the same eight voice presets, giving users a consistent set of voice choices across languages.</p>
        <span class="card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="home-capability" href="/features/">
        <span class="capability-number">02</span>
        <h3>Detailed speech controls</h3>
        <p>Speech rate, pitch, volume, inflection, head size, roughness, and breathiness can be adjusted independently, with Force controls for values that should take precedence over an application’s request.</p>
        <span class="card-arrow" aria-hidden="true">→</span>
      </a>
      <a class="home-capability" href="/dictionary/">
        <span class="capability-number">03</span>
        <h3>Text processing and pronunciation</h3>
        <p>Punctuation, number processing, abbreviations, emoji, emoticons, and user dictionaries provide ways to change how written material is prepared and pronounced.</p>
        <span class="card-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="page-section alt" aria-labelledby="home-setup-heading">
    <div class="shell home-start-grid">
      <div>
        <p class="section-kicker">Getting started</p>
        <h2 id="home-setup-heading">The basic setup takes only a few steps.</h2>
        <p class="section-summary">Install the application, make Eloqium the preferred Android TTS engine, and then choose the settings you want to use.</p>
      </div>
      <ol class="home-steps">
        <li><span>01</span><div><strong>Download and install Eloqium</strong><p>Download the current APK from the Download page and complete Android’s installation process.</p></div></li>
        <li><span>02</span><div><strong>Select Eloqium as the preferred engine</strong><p>Open Android’s text-to-speech settings from the application and select <strong>Eloqium TTS</strong> as the preferred engine.</p></div></li>
        <li><span>03</span><div><strong>Choose a language, voice, and controls</strong><p>Select a regional language variant and voice profile, then adjust speech and text-processing settings when you need to.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="page-section home-local-section" aria-labelledby="home-local-heading">
    <div class="shell narrow-copy">
      <p class="eyebrow">On-device processing</p>
      <h2 id="home-local-heading">Speech processing and synthesis run inside the Android application.</h2>
      <p>Eloqium does not request the Android <code>INTERNET</code> permission. The application performs its text processing and native synthesis locally rather than requiring a network service for speech generation.</p>
      <div class="inline-links">
        <LinkArrow href="/privacy/" label="Read the privacy information" />
        <LinkArrow href="/download/" label="Download the current version" />
      </div>
    </div>
  </section>
</BaseLayout>
